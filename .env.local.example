# Copy this file to .env.local and fill in the values.
# Never commit .env.local.

# Required for search. Get it from Google Cloud Console:
# 1. Enable "Places API (New)" (not the legacy Places API).
# 2. Create an API key, restrict it to Places API (New).
# 3. Cap daily SearchText quota to ~30 so you stay inside the free monthly allowance.
GOOGLE_PLACES_API_KEY=AIzaSyCWsEx4POXjH50Gabz0kymfY9fKxWOoyUw

# Optional. If either is empty, the CRM falls back to LocalStorage in the browser.
# Get both from Supabase: Project Settings > API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
